{
	admin 0.0.0.0:2019
}

{$APP_ADDRESS:http://localhost} {
	encode zstd gzip

	@api path /api/* /health/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
}
