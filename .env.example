# Copy to .env for a server installation. Do not commit the resulting file.
COMPOSE_PROJECT_NAME=domovoy

# For first launch by IP use an explicit http:// address, for example:
APP_ADDRESS=http://192.168.1.100
APP_TIMEZONE=Europe/Moscow

POSTGRES_DB=domovoy
POSTGRES_USER=domovoy
# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Reserved for authentication in stage 2.
SECRET_KEY=replace-with-at-least-64-random-characters

LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=30
