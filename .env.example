# Copy to .env for a server installation. Do not commit the resulting file.
COMPOSE_PROJECT_NAME=domovoy

# For first launch by IP use an explicit http:// address, for example:
APP_ADDRESS=http://192.168.1.100
APP_TIMEZONE=Europe/Moscow

POSTGRES_DB=domovoy
POSTGRES_USER=domovoy
# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Application secret. Never reuse it between installations.
SECRET_KEY=replace-with-at-least-64-random-characters
# Keep false for initial HTTP-by-IP access. Set true together with an HTTPS domain.
COOKIE_SECURE=false
SESSION_TTL_HOURS=720

LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=30

# Optional notification channels. Keep blank until HTTPS and providers are configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
